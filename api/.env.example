# Plantilla de variables de entorno del backend.
# Copiar este archivo como .env y completar los valores. El .env real NUNCA va al repositorio.
# Ver SEGURIDAD_DEPLOY.md para la puesta en produccion.

# ---------------------------------------------------------------------------
# OBLIGATORIAS
# ---------------------------------------------------------------------------

# Conexion a PostgreSQL: postgresql://USUARIO:CONTRASENA@HOST:PUERTO/BASE
DATABASE_URL=

# Clave que firma los tokens de login y los links de reseteo de contrasena.
# En produccion: larga y aleatoria. Generarla con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# ---------------------------------------------------------------------------
# PRODUCCION (en desarrollo local se pueden dejar vacias)
# ---------------------------------------------------------------------------

# Nunca True en produccion: muestra el codigo y la configuracion ante un error
DEBUG=False

# Dominios del backend separados por coma. Vacio = cualquiera (solo desarrollo)
ALLOWED_HOSTS=

# Direcciones del frontend que pueden llamar a la API, separadas por coma. Vacio = cualquiera (solo desarrollo)
CORS_ALLOWED_ORIGINS=

# Direccion del frontend: se usa en el link del correo de reseteo de contrasena
FRONTEND_URL=http://localhost:3000

# True cuando el servidor tenga certificado HTTPS (cookies seguras, redireccion y HSTS)
USAR_HTTPS=False

# ---------------------------------------------------------------------------
# CORREO (reseteo de contrasena). Por defecto se imprime en la terminal.
# ---------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Para enviar correos reales:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@ipvu.com

# ---------------------------------------------------------------------------
# MICROSERVICIO DE IA (autocompletado de DDJJ)
# ---------------------------------------------------------------------------

# Vacio = servicio local en http://localhost:8001
IA_API_URL=
# Clave que pide el microservicio en el header X-API-Key (si la tiene activada)
IA_API_KEY=
# Segundos de espera antes de responder "servicio no disponible"
IA_API_TIMEOUT=90

# ---------------------------------------------------------------------------
# SOLO DESARROLLO
# ---------------------------------------------------------------------------

# Usuario con el que el script gestion/management/commands/pruebas-20.py carga datos de prueba
PRUEBAS_USUARIO=
PRUEBAS_PASSWORD=
